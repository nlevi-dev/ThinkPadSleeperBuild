#include <Wire.h>

#define EEPROM_SIZE 8192

void setup() {
    Serial.begin(9600);
    while (!Serial);
    Wire.begin();
    Wire.setClock(1000);
    Serial.println("ready");

    // Scan
    int found = -1;
    int count = 0;
    for (byte addr = 1; addr < 127; addr++) {
        Wire.beginTransmission(addr);
        if (Wire.endTransmission() == 0) {
            found = addr;
            count++;
        }
    }

    if (count == 0) {
        Serial.println("error: no I2C devices found");
        return;
    }
    if (count > 1) {
        Serial.print("multiple I2C devices found: ");
        for (byte addr = 1; addr < 127; addr++) {
            Wire.beginTransmission(addr);
            if (Wire.endTransmission() == 0) {
                Serial.print("0x"); Serial.print(addr, HEX); Serial.print(" ");
            }
        }
        Serial.println();
        Serial.println("enter address (e.g. 0x50):");
        while (!Serial.available());
        String input = Serial.readStringUntil('\n');
        input.trim();
        found = (int)strtol(input.c_str(), nullptr, 16);
        Serial.print("using 0x"); Serial.println(found, HEX);
    }

    // the first chunk always comes out corrupt, so read 0x20 extra and discard,
    // then read 0x00-0x1F separately at the end (EEPROM counter wraps at 0x80)
    Wire.beginTransmission(found);
    Wire.write(0x00);
    Wire.endTransmission();
    delay(10);

    // discard first 32 bytes
    Wire.requestFrom(found, 32);
    while (Wire.available()) Wire.read();

    // read 0x20-0x7F (96 bytes)
    byte buf[128];
    int total = 0;
    while (total < 96) {
        Wire.beginTransmission(found);
        Wire.write(0x20 + total);
        Wire.endTransmission(false);
        int chunk = Wire.requestFrom(found, 32);
        for (int i = 0; i < chunk; i++)
            buf[0x20 + total + i] = Wire.read();
        total += chunk;
        if (chunk < 32) break;
    }

    // read 0x00-0x1F separately
    Wire.beginTransmission(found);
    Wire.write(0x00);
    Wire.endTransmission(false);
    Wire.requestFrom(found, 32);
    for (int i = 0; i < 32; i++)
        buf[i] = Wire.available() ? Wire.read() : 0xFF;

    // print full 128 bytes in order
    for (int i = 0; i < 128; i++) {
        if (buf[i] < 0x10) Serial.print("0");
        Serial.print(buf[i], HEX);
        Serial.print((i + 1) % 16 == 0 ? "\n" : " ");
    }
}

void loop() {}
